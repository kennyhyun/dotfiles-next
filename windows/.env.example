# Linuxdev SSH Port-Forward GUI -- example configuration.
# Copy this file to ".env" in the same folder as the scripts, then edit.

# Ports to forward from Windows into the WSL distro.
# Comma/space separated. "host:wsl" maps different ports on each side;
# a bare "port" maps the same number. Text after # is a comment.
FORWARD_PORTS=15476:5476,4322,4323,4324

# WSL distro name. Optional -- auto-detected when exactly one distro exists.
WSL_DISTRO_NAME=linuxdev

# SSH user inside the distro. Optional -- defaults to the Windows user name.
WSL_USERNAME=youruser

# Start tunnels automatically when the GUI app opens. The checkbox in the GUI
# writes this value; you can also set it here (true/false).
AUTO_START_TUNNELS=false
