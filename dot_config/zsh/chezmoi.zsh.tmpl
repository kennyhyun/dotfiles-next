# ~/.config/zsh/chezmoi.zsh — managed by chezmoi.
# This is the shared, machine-independent zsh config. It is NOT ~/.zshrc.
#
# The post-apply setup ensures your ~/.zshrc exists (creating an empty one if
# needed) and that its FIRST line sources this file:
#
#   [ -r ~/.config/zsh/chezmoi.zsh ] && source ~/.config/zsh/chezmoi.zsh
#
# So ~/.zshrc itself plays the role of the old ~/.zshrc.local: put anything
# host-specific (custom functions, extra env, machine paths) directly in your
# ~/.zshrc, below that first source line. chezmoi never overwrites ~/.zshrc.

# ---- PATH: Homebrew (Linuxbrew) + user-local bin ----
# Everything below (fnm, fzf, nvim via $EDITOR, chezmoi itself) comes from brew
# or ~/.local/bin, so this MUST run before any of them. brew's own install adds
# a shellenv line to a login file, but we do not rely on that being present:
# resolve brew from its known prefixes and load it here so a fresh login shell
# always has the right PATH. ~/.local/bin holds user-installed tools (chezmoi,
# pipx shims) that are not on PATH by default.
for _brew in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
  if [ -x "$_brew" ]; then
    eval "$("$_brew" shellenv)"
    break
  fi
done
unset _brew
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

# ---- Editor ----
export VISUAL=nvim
export EDITOR="$VISUAL"
alias vi=nvim
alias vim=nvim

# ---- Node via fnm (Fast Node Manager) ----
if command -v fnm >/dev/null 2>&1; then
  eval "$(fnm env --use-on-cd --shell zsh)"
fi

# ---- fzf (fuzzy finder + Ctrl-R history search) ----
if command -v fzf >/dev/null 2>&1; then
  source <(fzf --zsh) 2>/dev/null || true
fi

# ---- Key bindings: emacs mode for the zsh line editor ----
# Scope is ONLY zsh's line editor (ZLE) — git ($EDITOR=nvim), less and tmux
# have their own keymaps and are unaffected. This keeps ^A/^E/^R/^K etc. working
# as expected regardless of $EDITOR or $VISUAL being set to nvim above.
bindkey -e

# Ctrl-X Ctrl-E: edit the current command line in $EDITOR (nvim).
# Best way to edit long / multi-line commands comfortably.
autoload -Uz edit-command-line
zle -N edit-command-line
bindkey '^X^E' edit-command-line

# ---- Up/Down: prefix history search (what oh-my-zsh used to bind) ----
# Type part of a command, press Up, and only matching earlier commands appear
# (cursor stays put). zsh's default up-line-or-history just walks history with
# no prefix match; up-line-or-beginning-search gives the expected behaviour.
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
# Bind terminfo codes (what the terminal actually sends) and the common
# fallbacks, so it works in tmux, raw consoles and across terminals.
bindkey "${terminfo[kcuu1]:-^[[A}" up-line-or-beginning-search     # Up
bindkey "${terminfo[kcud1]:-^[[B}" down-line-or-beginning-search   # Down
bindkey '^[[A' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search
bindkey '^[OA' up-line-or-beginning-search    # application-mode cursor keys
bindkey '^[OB' down-line-or-beginning-search

# ---- Navigation/editing keys (also lost with oh-my-zsh) ----
# bindkey -e only populates the keys zsh knows from this terminal; keys like
# Delete/Home/End were filled in by oh-my-zsh and now come up undefined-key
# (Delete printed a literal '~'). Bind the terminfo codes with the usual
# xterm/VT fallbacks so they work over SSH, tmux and raw consoles alike.
bindkey "${terminfo[kdch1]:-^[[3~}" delete-char          # Delete
bindkey '^[[3~' delete-char                              # Delete (xterm/VT)
bindkey "${terminfo[khome]:-^[[H}" beginning-of-line     # Home
bindkey "${terminfo[kend]:-^[[F}"  end-of-line           # End
bindkey '^[[H' beginning-of-line
bindkey '^[[F' end-of-line
bindkey '^[[1~' beginning-of-line                        # Home (VT/linux)
bindkey '^[[4~' end-of-line                              # End  (VT/linux)
bindkey '^[OH' beginning-of-line                         # Home (application)
bindkey '^[OF' end-of-line                               # End  (application)

# ---- ZFS: check the kernel module can load before `zpool import` ----
# On Debian the ZFS module is built by DKMS; with Secure Boot on it will not
# load until the DKMS key is enrolled. Before `zpool import` (also via
# `sudo zpool import`) run scripts/zfs_check.sh: silent when ZFS is ready, else
# it prints the enrolment steps and the import is NOT run.
# Only for interactive zsh (functions, so `sudo` is covered too; a PATH wrapper
# would be bypassed by sudo's secure_path). Defined only where zpool exists.
# Override the checker path with ZFS_CHECK=/path/to/zfs_check.sh.
if command -v zpool >/dev/null 2>&1; then
  _zfs_guard() {
    local chk="${ZFS_CHECK:-{{ .chezmoi.sourceDir }}/scripts/zfs_check.sh}"
    [ -x "$chk" ] || return 0
    local out rc
    out="$("$chk" 2>&1)"; rc=$?
    # Quiet only when ready AND loaded; otherwise show what the check said.
    if [ $rc -ne 0 ] || [ ! -d /sys/module/zfs ]; then print -r -- "$out"; fi
    return $rc
  }
  zpool() {
    if [[ "$1" == import ]]; then _zfs_guard || return 1; fi
    command zpool "$@"
  }
  sudo() {
    if [[ "$1" == zpool && "$2" == import ]]; then _zfs_guard || return 1; fi
    command sudo "$@"
  }
fi

# ---- History: persist across sessions ----
# Without these zsh keeps history only in memory for the current session and
# drops it on exit (default SAVEHIST is 0). HISTFILE gives it somewhere to
# write; the options append/share across concurrent sessions and de-dup.
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt APPEND_HISTORY        # append to $HISTFILE, do not overwrite it
setopt INC_APPEND_HISTORY    # write each command as it is run, not only at exit
setopt SHARE_HISTORY         # share history live across concurrent sessions
setopt HIST_IGNORE_DUPS      # do not record a command identical to the previous
setopt HIST_IGNORE_SPACE     # a command starting with a space is not recorded
setopt HIST_REDUCE_BLANKS    # trim superfluous whitespace before recording
setopt EXTENDED_HISTORY      # record start timestamp and elapsed time
