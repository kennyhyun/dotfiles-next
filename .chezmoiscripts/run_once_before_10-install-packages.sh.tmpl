#!/usr/bin/env bash
# Installs packages and build tools. Homebrew-first so it works without root
# wherever possible.
#
# Settings. Keep them in ~/.config/chezmoi/chezmoi.toml under [data]:
#   role = "base" | "linuxdev" | "lite"
#   production, no_sudo, with_microk8s, with_kirocrew, with_zfs, with_clamav,
#   with_trivy, with_suricata, with_security   (true / false)
# with_security is an umbrella: it turns on clamav, trivy and suricata, and
# installs osv-scanner even on roles without dev tooling. osv-scanner is
# otherwise installed by default with dev tooling.
# A DOTFILES_<NAME> environment variable (DOTFILES_ROLE, DOTFILES_NO_SUDO,
# DOTFILES_WITH_ZFS, ...) overrides the file for one run. The old unprefixed
# names (PRODUCTION, NO_SUDO, WITH_*) still work but print a warning.
# Resolution lives in .chezmoitemplates/settings.sh, shared with the setup script.
#
# SAFETY: if role / production / no_sudo differ from the last successful run
# (recorded in ~/.local/state/dotfiles/applied), or nothing was ever recorded and
# no role is set, the script prints what changed and stops. Re-run with
# DOTFILES_ACCEPT_CHANGE=1 to accept. It never uninstalls anything.
#
# Flags (written here in their old env-var form):
#   PRODUCTION=1   -> skip developer tooling (awscli/deno/opentofu/graphviz),
#                     install essentials only
#   DOTFILES_ROLE  -> "linuxdev": install docker (microk8s is opt-in, see
#                                 WITH_MICROK8S below). Needs sudo.
#                     "lite":     low-footprint server. Skips dev tooling AND
#                                 the heavy apt packages (build-essential,
#                                 default-jre, perf tools) and kubectl; installs
#                                 podman instead of docker; Neovim runs with NO
#                                 plugins (a marker file tells init.lua to skip
#                                 lazy.nvim). For small / memory-constrained or
#                                 security-sensitive servers.
#   NO_SUDO=1      -> never call sudo; skip all steps that require root
#                     (system apt packages, kubectl to /usr/local/bin). Use on
#                     machines where you only have your home directory.
#   WITH_MICROK8S=1-> opt in to microk8s on the linuxdev role (heavy: snap,
#                     hundreds of MB). Off by default, even for linuxdev.
#   WITH_KIROCREW=1-> opt in to installing Kiro Crew (self-hosted agent
#                     gateway). Heavy (own venv + ~610MB model). Needs
#                     KIROCREW_INSTALL_URL set (see scripts/install_kirocrew.sh).
#                     Off by default on every role.
#   WITH_ZFS=1     -> opt in to zfsutils-linux (Linux, needs sudo). On Debian
#                     the kernel module is built by DKMS, and with Secure Boot
#                     on it will not load until the DKMS key is enrolled
#                     (one reboot, console access). After installing, the
#                     script runs scripts/zfs_check.sh, which prints the steps
#                     if that is still needed. Off by default on every role.
#   WITH_ORBSTACK=1-> opt in to OrbStack on macOS: a native lightweight VM that
#                     replaces Docker Desktop (drop-in Docker socket + CLI). GUI
#                     menubar app. Free for personal use, paid for commercial.
#                     https://orbstack.dev. Skipped on Linux.
#   WITH_NAS=1     -> umbrella for the NAS share stack: turns on WITH_COCKPIT,
#                     WITH_SAMBA and WITH_NFS. Off by default on every role.
#   WITH_COCKPIT=1 -> opt in to Cockpit, a light socket-activated web admin UI
#                     (+ cockpit-file-sharing, the Samba/NFS share manager).
#                     https://<host>:9090. Needs sudo. Off by default.
#   WITH_SAMBA=1   -> opt in to the Samba (SMB/CIFS) server for mixed-client
#                     (Windows/macOS/Linux) shares. Installs the service only;
#                     defines no shares. Needs sudo. Off by default.
#   WITH_NFS=1     -> opt in to the NFS kernel server for Linux/Unix-native
#                     shares. Installs the service only; defines no exports.
#                     Needs sudo. Off by default.
#
# Read-only rootfs (e.g. linuxdev WSL): if `rootfs-rw`/`rootfs-ro` helpers exist
# and the rootfs is read-only, it is unlocked before sudo installs and re-locked
# afterwards (guaranteed via an EXIT trap, even on failure).

set -euo pipefail

{{ template "settings.sh" . }}

# ---- Safety: stop if the settings changed since the last successful run ----
# We compare only role / production / no_sudo: they change the whole install
# scope. The opt-in with_* switches are explicit and additive, so they are not
# compared. The record is written at the very end, only after success.
STATE_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/applied"
_flag() { if [ -n "$1" ]; then printf 1; else printf 0; fi; }
SETTINGS_NOW="$(printf 'role=%s\nproduction=%s\nno_sudo=%s\n' \
  "$ROLE" "$(_flag "$PRODUCTION")" "$(_flag "$NO_SUDO")")"

settings_guard() {
  local prev
  if [ -f "$STATE_FILE" ]; then
    prev="$(cat "$STATE_FILE")"
    if [ "$prev" = "$SETTINGS_NOW" ] || [ -n "$ACCEPT_CHANGE" ]; then
      return 0
    fi
    {
      printf '\n\033[1;31m==> STOPPED: install settings changed since the last run\033[0m\n'
      printf '\nlast successful run:\n'; printf '%s\n' "$prev" | sed 's/^/    /'
      printf '\nthis run:\n';           printf '%s\n' "$SETTINGS_NOW" | sed 's/^/    /'
      printf '\nIf this is intended, accept it once:\n'
      printf '    DOTFILES_ACCEPT_CHANGE=1 chezmoi apply\n'
      printf 'If not, fix role / production / no_sudo in ~/.config/chezmoi/chezmoi.toml.\n'
      printf 'To update files only (no install scripts): chezmoi apply --exclude=scripts\n\n'
    } >&2
    exit 1
  fi
  # No record yet. A role that was set explicitly is a deliberate choice; an
  # unset role would silently become "base", which is how a lite or linuxdev
  # machine gets the wrong package set.
  if [ -z "$ROLE_EXPLICIT" ] && [ -z "$ACCEPT_CHANGE" ]; then
    {
      printf '\n\033[1;31m==> STOPPED: no role is set and no earlier run is recorded\033[0m\n'
      printf '\nThe role would default to "base". Set it in ~/.config/chezmoi/chezmoi.toml:\n'
      printf '    [data]\n    role = "linuxdev"    # or "lite" / "base"\n'
      printf '\nOr, to accept "base" once: DOTFILES_ACCEPT_CHANGE=1 chezmoi apply\n'
      printf 'To update files only (no install scripts): chezmoi apply --exclude=scripts\n\n'
    } >&2
    exit 1
  fi
}

# Written only at the very end of a successful run.
settings_record() {
  mkdir -p "$(dirname "$STATE_FILE")"
  printf '%s\n' "$SETTINGS_NOW" > "$STATE_FILE"
}

settings_guard

SKIP_DEVTOOLS=""
[ -n "${PRODUCTION:-}" ] && SKIP_DEVTOOLS=1

# "lite" is a low-footprint server role: it implies SKIP_DEVTOOLS and further
# trims the apt list, swaps docker->podman, and runs Neovim plugin-free.
LITE=""
[ "$ROLE" = "lite" ] && { LITE=1; SKIP_DEVTOOLS=1; }

log() { printf '\n\033[1;34m==> %s\033[0m\n' "$*"; }

OS="$(uname -s)"

# have_sudo: true only if sudo is usable AND the user hasn't opted out.
have_sudo() {
  [ -z "${NO_SUDO:-}" ] && command -v sudo >/dev/null 2>&1 && sudo -n true 2>/dev/null
}

# ---- read-only rootfs support (e.g. linuxdev WSL) ----
# Some systems keep the root filesystem read-only and expose rootfs-rw /
# rootfs-ro helpers to toggle it (bind-remount of /usr /etc ... including the
# systemd PID-1 mount namespace).
#
# Design: *lazy* unlock. We do NOT unlock up-front. Instead each install step
# calls rootfs_ensure_rw() only once it has decided it actually has something
# to write. If every package is already installed, rootfs_ensure_rw is never
# called and the rootfs is never touched. rootfs_ensure_rw is idempotent, so
# multiple steps can call it freely; the single EXIT trap re-locks at the end,
# but only if WE unlocked (a normally-rw machine is left untouched).
ROOTFS_WE_UNLOCKED=""

# rootfs_is_ro: true if /etc is currently not writable (proxy for ro rootfs).
rootfs_is_ro() {
  local probe="/etc/.dotfiles-rw-probe.$$"
  if sudo test -w /etc 2>/dev/null && sudo touch "$probe" 2>/dev/null; then
    sudo rm -f "$probe" 2>/dev/null || true
    return 1   # writable -> NOT read-only
  fi
  return 0     # read-only
}

# rootfs_ensure_rw: make the rootfs writable *if needed*. Safe to call many
# times. No-op when: no helper, no sudo, already unlocked by us, or already rw.
rootfs_ensure_rw() {
  [ -n "$ROOTFS_WE_UNLOCKED" ] && return 0            # we already unlocked
  command -v rootfs-rw >/dev/null 2>&1 || return 0    # no helper -> nothing to do
  have_sudo || return 0
  rootfs_is_ro || return 0                            # already rw -> leave as-is
  log "Read-only rootfs detected: unlocking (rootfs-rw)"
  if sudo rootfs-rw; then
    ROOTFS_WE_UNLOCKED=1
    trap rootfs_relock EXIT INT TERM                  # guarantee re-lock
  else
    echo "WARNING: rootfs-rw failed; sudo installs may fail on read-only dirs."
  fi
}

rootfs_relock() {
  [ -n "$ROOTFS_WE_UNLOCKED" ] || return 0
  command -v rootfs-ro >/dev/null 2>&1 || return 0
  log "Re-locking rootfs (rootfs-ro)"
  sudo rootfs-ro || echo "WARNING: rootfs-ro failed; rootfs left writable."
  ROOTFS_WE_UNLOCKED=""
  trap - EXIT INT TERM
}

ensure_brew() {
  for p in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
    [ -x "$p" ] && eval "$("$p" shellenv)" && return 0
  done
  log "Installing Homebrew"
  # NOTE: On Linux, Homebrew's first-time install needs sudo to create
  # /home/linuxbrew. If you have no root at all, pre-install brew to a path you
  # own and re-run. (See https://docs.brew.sh/Installation for a no-sudo path.)
  NONINTERACTIVE=1 /bin/bash -c \
    "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  for p in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
    [ -x "$p" ] && eval "$("$p" shellenv)" && return 0
  done
}

# System packages (Linux, apt) — only when we have root. On macOS the C
# toolchain comes from Xcode CLT; everything else comes from brew.
install_system_packages() {
  if [ "$OS" = "Darwin" ]; then
    xcode-select -p >/dev/null 2>&1 || xcode-select --install || true
    return 0
  fi
  if ! have_sudo; then
    log "No sudo (or NO_SUDO set): skipping apt packages."
    echo "  Make sure a C compiler + headers exist for treesitter, e.g.:"
    echo "    sudo apt-get install build-essential"
    echo "  Otherwise brew's gcc is used, which still needs system libc headers."
    return 0
  fi
  local distro perf_pkg
  distro="$(grep '^ID=' /etc/os-release | cut -d= -f2 | tr -d '"')"
  if [ "$distro" = "ubuntu" ]; then perf_pkg="linux-tools-common"; else perf_pkg="linux-perf"; fi

  # Base apt list. Always-needed essentials that are cheap on disk.
  local want missing=""
  local pkgs="
    apt-transport-https ca-certificates
    git git-lfs
    htop
    jq curl
    net-tools psmisc
  "
  # Heavy / developer packages: skipped on the "lite" server role.
  #   build-essential : C compiler + libc headers (treesitter, source builds)
  #   default-jre      : a whole JRE, ~100-200MB
  #   perf tools       : kernel perf counters
  #   python/pipx      : local python tooling
  #   xclip / lshw     : desktop clipboard / hardware probe, rarely useful on a
  #                      headless server
  if [ -z "$LITE" ]; then
    pkgs="$pkgs
      build-essential
      $perf_pkg
      python3-pip python3-venv pipx
      default-jre
      xclip
      lshw
    "
  fi

  for want in $pkgs; do
    # Keep only packages that are not already installed.
    dpkg -s "$want" >/dev/null 2>&1 || missing="$missing $want"
  done

  if [ -z "$missing" ]; then
    log "All apt packages already installed; skipping (no rootfs unlock needed)."
    return 0
  fi

  log "Installing missing apt packages:$missing"
  rootfs_ensure_rw                 # unlock only now that we know we must write
  sudo apt-get update
  # shellcheck disable=SC2086  # intentional word-splitting of the package list
  sudo apt-get install -y $missing
}

# Everything else via brew (no root needed once brew exists).
install_brew_packages() {
  log "Installing Homebrew packages"
  brew update
  # Core CLI + editor + shell niceties, all user-local via brew.
  brew install \
    neovim \
    tmux \
    zsh \
    zsh-autosuggestions \
    zsh-syntax-highlighting \
    ripgrep fd jq git-lfs httpie fzf
  # kubectl only off the lite role (lite uses podman, no k8s client by default).
  if [ -z "$LITE" ]; then
    brew install kubernetes-cli
  fi
  # Developer tooling (skipped by PRODUCTION / lite). fnm is here because Node
  # is treated as dev tooling: a production / lite server gets no Node runtime.
  if [ -z "$SKIP_DEVTOOLS" ]; then
    brew install fnm awscli deno opentofu graphviz
  fi
  # osv-scanner: scans lockfiles for known vulnerabilities AND known malicious
  # packages (OSV + OpenSSF malicious-packages feed). A single user-local
  # binary, no daemon, no root. Installed with dev tooling by default, and on
  # every role (lite / production too) when with_security is on.
  if [ -z "$SKIP_DEVTOOLS" ] || [ -n "${WITH_SECURITY:-}" ]; then
    brew install osv-scanner
  fi
}

# lite role: podman instead of docker. podman is daemonless + rootless, so it
# is a better fit for a low-footprint server than the docker daemon. Installed
# from apt (official packages on current Debian/Ubuntu).
install_lite_extras() {
  [ "$OS" != "Linux" ] && return 0
  [ -n "$LITE" ] || return 0
  if ! have_sudo; then
    log "lite role requested but no sudo: skipping podman (install it later)."
    return 0
  fi
  if command -v podman >/dev/null 2>&1; then
    log "podman already installed ($(podman --version 2>/dev/null)); skipping."
    return 0
  fi
  log "lite role: installing podman"
  rootfs_ensure_rw                 # unlock only now that we know we must write
  sudo apt-get install -y podman \
    || echo "Could not install podman via apt (is the package available?)."
}

# linuxdev extras need root (docker/microk8s touch system services).
install_role_extras() {
  [ "$OS" != "Linux" ] && return 0
  [ "$ROLE" = "linuxdev" ] || return 0
  [ -n "$SKIP_DEVTOOLS" ] && return 0
  if ! have_sudo; then
    log "linuxdev role requested but no sudo: skipping docker/microk8s."
    return 0
  fi

  # Decide what actually needs installing (both sub-scripts are idempotent, but
  # we check here too so we only unlock the rootfs when there is real work).
  #   docker   : installed by default for the linuxdev role.
  #   microk8s : heavy (snap, hundreds of MB). OPT-IN only — set WITH_MICROK8S=1
  #              to install it. Kept out of the default linuxdev set so a dev box
  #              does not pay the k8s cost unless it asks for it.
  local sdir="{{ .chezmoi.sourceDir }}/scripts"
  local need_docker="" need_microk8s=""
  [ -x "$sdir/install_docker.sh" ]   && ! docker version        >/dev/null 2>&1 && need_docker=1
  if [ -n "${WITH_MICROK8S:-}" ]; then
    [ -x "$sdir/install_microk8s.sh" ] && [ -z "$(snap microk8s --version 2>/dev/null)" ] && need_microk8s=1
  fi

  if [ -z "$need_docker" ] && [ -z "$need_microk8s" ]; then
    log "docker present (and microk8s not requested / already present); skipping."
    return 0
  fi

  log "linuxdev role: installing${need_docker:+ docker}${need_microk8s:+ microk8s}"
  rootfs_ensure_rw                 # unlock only now that we know we must write
  [ -n "$need_microk8s" ] && "$sdir/install_microk8s.sh" || true
  [ -n "$need_docker" ]   && "$sdir/install_docker.sh" || true
}

# Tailscale (mesh VPN), all machines. CLI and daemon ship as one package.
#   Linux : scripts/install_tailscale.sh runs the official installer (apt repo
#           + tailscaled systemd service); needs root and touches the rootfs,
#           so we unlock lazily — only when tailscale is actually missing.
#   macOS : brew cask.
# Idempotent: skips entirely if the tailscale binary already exists (and then
# a read-only rootfs is never unlocked).
install_tailscale() {
  if command -v tailscale >/dev/null 2>&1; then
    log "tailscale already installed ($(tailscale version 2>/dev/null | head -1)); skipping."
    return 0
  fi

  if [ "$OS" = "Darwin" ]; then
    log "Installing tailscale (brew cask)"
    brew install --cask tailscale
    return 0
  fi

  if ! have_sudo; then
    log "No sudo (or NO_SUDO set): skipping tailscale."
    echo "  Install later with: scripts/install_tailscale.sh"
    return 0
  fi
  log "Installing tailscale (systemd service)"
  rootfs_ensure_rw                 # unlock only now that we know we must write
  local sdir="{{ .chezmoi.sourceDir }}/scripts"
  [ -x "$sdir/install_tailscale.sh" ] && "$sdir/install_tailscale.sh" || true
}

# ZFS (zfsutils-linux). OPT-IN via WITH_ZFS=1. On Debian it pulls in zfs-dkms,
# which builds the kernel module locally and signs it with a DKMS key. With
# Secure Boot on, that key must be enrolled once (mokutil) before the module
# loads. We do not fail the whole install over it: zfs_check.sh prints the
# steps and we carry on. Debian needs the "contrib" apt component for this.
install_zfs() {
  [ -n "${WITH_ZFS:-}" ] || return 0
  [ "$OS" = "Linux" ] || return 0
  local sdir="{{ .chezmoi.sourceDir }}/scripts"
  if ! command -v zpool >/dev/null 2>&1; then
    if ! have_sudo; then
      log "WITH_ZFS=1 but no sudo: skipping zfsutils-linux."
      return 0
    fi
    log "Installing zfsutils-linux"
    rootfs_ensure_rw               # unlock only now that we know we must write
    sudo apt-get update
    sudo apt-get install -y zfsutils-linux \
      || echo "Could not install zfsutils-linux (on Debian, is 'contrib' enabled in apt sources?)."
  fi
  if [ -x "$sdir/zfs_check.sh" ]; then
    log "Checking that the ZFS kernel module can load"
    "$sdir/zfs_check.sh" || echo "  (ZFS needs the step above before 'zpool import' works.)"
  fi
}

# Security tooling. All three are OPT-IN (heavy and/or box-specific) and never
# installed by default on any role. Each sub-script is idempotent.
#   WITH_CLAMAV=1   : on-demand malware scanner (Win+Linux sigs). clamscan.
#   WITH_TRIVY=1    : CVE / misconfig / secret scanner (NOT malware). trivy.
#   WITH_SURICATA=1 : network IDS. Installs + fetches rules but does NOT start
#                     monitoring (the interface to watch is host-specific).
install_security_tools() {
  [ "$OS" = "Linux" ] || return 0
  local sdir="{{ .chezmoi.sourceDir }}/scripts"
  local need_clamav="" need_trivy="" need_suricata=""
  [ -n "${WITH_CLAMAV:-}" ]   && ! command -v clamscan >/dev/null 2>&1 && need_clamav=1
  [ -n "${WITH_TRIVY:-}" ]    && ! command -v trivy    >/dev/null 2>&1 && need_trivy=1
  [ -n "${WITH_SURICATA:-}" ] && ! command -v suricata >/dev/null 2>&1 && need_suricata=1

  if [ -z "$need_clamav" ] && [ -z "$need_trivy" ] && [ -z "$need_suricata" ]; then
    return 0
  fi
  if ! have_sudo; then
    log "security tools requested but no sudo: skipping clamav/trivy/suricata."
    return 0
  fi

  log "installing security tools:${need_clamav:+ clamav}${need_trivy:+ trivy}${need_suricata:+ suricata}"
  rootfs_ensure_rw                 # unlock only now that we know we must write
  [ -n "$need_clamav" ]   && [ -x "$sdir/install_clamav.sh" ]   && "$sdir/install_clamav.sh"   || true
  [ -n "$need_trivy" ]    && [ -x "$sdir/install_trivy.sh" ]    && "$sdir/install_trivy.sh"    || true
  [ -n "$need_suricata" ] && [ -x "$sdir/install_suricata.sh" ] && "$sdir/install_suricata.sh" || true
}

# NAS share stack. All OPT-IN (WITH_NAS umbrella, or the individual switches)
# and never installed by default on any role. Each sub-script is idempotent and
# installs the service only -- it defines NO shares/exports, because a share
# path is host-specific (usually a ZFS dataset). Manage shares afterwards from
# the Cockpit File Sharing web UI, or by hand in smb.conf / /etc/exports.
#   WITH_COCKPIT=1 : light web admin UI + cockpit-file-sharing (share manager).
#   WITH_SAMBA=1   : SMB/CIFS server for mixed Windows/macOS/Linux clients.
#   WITH_NFS=1     : NFS kernel server for Linux/Unix-native clients.
install_nas() {
  [ "$OS" = "Linux" ] || return 0
  local sdir="{{ .chezmoi.sourceDir }}/scripts"
  local need_cockpit="" need_samba="" need_nfs=""
  [ -n "${WITH_COCKPIT:-}" ] && ! command -v cockpit-bridge >/dev/null 2>&1 && need_cockpit=1
  [ -n "${WITH_SAMBA:-}" ]   && ! command -v smbd           >/dev/null 2>&1 && need_samba=1
  [ -n "${WITH_NFS:-}" ]     && ! dpkg -s nfs-kernel-server  >/dev/null 2>&1 && need_nfs=1

  if [ -z "$need_cockpit" ] && [ -z "$need_samba" ] && [ -z "$need_nfs" ]; then
    return 0
  fi
  if ! have_sudo; then
    log "NAS stack requested but no sudo: skipping cockpit/samba/nfs."
    return 0
  fi

  log "installing NAS stack:${need_cockpit:+ cockpit}${need_samba:+ samba}${need_nfs:+ nfs}"
  rootfs_ensure_rw                 # unlock only now that we know we must write
  [ -n "$need_cockpit" ] && [ -x "$sdir/install_cockpit.sh" ] && "$sdir/install_cockpit.sh" || true
  [ -n "$need_samba" ]   && [ -x "$sdir/install_samba.sh" ]   && "$sdir/install_samba.sh"   || true
  [ -n "$need_nfs" ]     && [ -x "$sdir/install_nfs.sh" ]     && "$sdir/install_nfs.sh"     || true
}

# macOS container runtime. OrbStack is a native lightweight VM that is a drop-in
# Docker Desktop replacement. Free for personal use, paid for commercial.
# Skipped on Linux (the linuxdev role handles Docker natively).
install_macos_docker() {
  [ "$OS" = "Darwin" ] || return 0
  [ -n "${WITH_ORBSTACK:-}" ] || return 0
  if command -v orb >/dev/null 2>&1; then
    log "OrbStack already installed ($(orb version 2>/dev/null | head -1)); skipping."
    return 0
  fi
  log "Installing OrbStack (brew cask)"
  brew install --cask orbstack
}

# Neovim runs plugin-free on the lite role. We drop a marker file that
# init.lua checks; when present it skips the lazy.nvim bootstrap entirely, so
# no third-party plugins are cloned/compiled (smaller footprint + no plugin
# supply-chain surface on a server). Built-in syntax highlighting still works.
set_nvim_profile() {
  local marker="$HOME/.config/nvim/.minimal"
  if [ -n "$LITE" ]; then
    mkdir -p "$HOME/.config/nvim"
    : > "$marker"
    log "lite role: Neovim set to plugin-free (marker: $marker)"
  else
    rm -f "$marker" 2>/dev/null || true
  fi
}

# Kiro Crew (self-hosted agent gateway). OPT-IN via WITH_KIROCREW=1 — it is
# heavy (its own CPython 3.12 venv + a ~610MB embedding model) and not wanted on
# every box, so it is never installed by default on any role. The sub-script is
# idempotent (skips if kirocrew is already present) and needs the official
# installer URL in KIROCREW_INSTALL_URL (it does not hard-code one).
install_kirocrew() {
  [ -n "${WITH_KIROCREW:-}" ] || return 0
  local sdir="{{ .chezmoi.sourceDir }}/scripts"
  if [ -x "$sdir/install_kirocrew.sh" ]; then
    log "WITH_KIROCREW=1: installing Kiro Crew"
    "$sdir/install_kirocrew.sh" || echo "kiro crew install reported an issue (see output above)."
  fi
}

# brew installs to its own prefix and needs no root / no rootfs unlock.
# System/apt steps unlock the rootfs lazily (only when they have something to
# install); the EXIT trap set by rootfs_ensure_rw re-locks afterwards.
install_system_packages
install_role_extras
install_lite_extras
install_tailscale
install_zfs
install_security_tools
install_nas
install_macos_docker

ensure_brew
install_brew_packages
set_nvim_profile
install_kirocrew

settings_record
log "Package installation complete."
