#!/usr/bin/env bash
# Installs packages and build tools. Homebrew-first so it works without root
# wherever possible.
#
# Env flags:
#   PRODUCTION=1   -> skip developer tooling, install essentials only
#   DOTFILES_ROLE  -> "linuxdev" also installs docker + microk8s (needs sudo)
#   NO_SUDO=1      -> never call sudo; skip all steps that require root
#                     (system apt packages, kubectl to /usr/local/bin). Use on
#                     machines where you only have your home directory.
#
# Read-only rootfs (e.g. linuxdev WSL): if `rootfs-rw`/`rootfs-ro` helpers exist
# and the rootfs is read-only, it is unlocked before sudo installs and re-locked
# afterwards (guaranteed via an EXIT trap, even on failure).

set -euo pipefail

ROLE="${DOTFILES_ROLE:-base}"
SKIP_DEVTOOLS=""
[ -n "${PRODUCTION:-}" ] && SKIP_DEVTOOLS=1

log() { printf '\n\033[1;34m==> %s\033[0m\n' "$*"; }

OS="$(uname -s)"

# have_sudo: true only if sudo is usable AND the user hasn't opted out.
have_sudo() {
  [ -z "${NO_SUDO:-}" ] && command -v sudo >/dev/null 2>&1 && sudo -n true 2>/dev/null
}

# ---- read-only rootfs support (e.g. linuxdev WSL) ----
# Some systems keep the root filesystem read-only and expose rootfs-rw /
# rootfs-ro helpers to toggle it (bind-remount of /usr /etc ... including the
# systemd PID-1 mount namespace).
#
# Design: *lazy* unlock. We do NOT unlock up-front. Instead each install step
# calls rootfs_ensure_rw() only once it has decided it actually has something
# to write. If every package is already installed, rootfs_ensure_rw is never
# called and the rootfs is never touched. rootfs_ensure_rw is idempotent, so
# multiple steps can call it freely; the single EXIT trap re-locks at the end,
# but only if WE unlocked (a normally-rw machine is left untouched).
ROOTFS_WE_UNLOCKED=""

# rootfs_is_ro: true if /etc is currently not writable (proxy for ro rootfs).
rootfs_is_ro() {
  local probe="/etc/.dotfiles-rw-probe.$$"
  if sudo test -w /etc 2>/dev/null && sudo touch "$probe" 2>/dev/null; then
    sudo rm -f "$probe" 2>/dev/null || true
    return 1   # writable -> NOT read-only
  fi
  return 0     # read-only
}

# rootfs_ensure_rw: make the rootfs writable *if needed*. Safe to call many
# times. No-op when: no helper, no sudo, already unlocked by us, or already rw.
rootfs_ensure_rw() {
  [ -n "$ROOTFS_WE_UNLOCKED" ] && return 0            # we already unlocked
  command -v rootfs-rw >/dev/null 2>&1 || return 0    # no helper -> nothing to do
  have_sudo || return 0
  rootfs_is_ro || return 0                            # already rw -> leave as-is
  log "Read-only rootfs detected: unlocking (rootfs-rw)"
  if sudo rootfs-rw; then
    ROOTFS_WE_UNLOCKED=1
    trap rootfs_relock EXIT INT TERM                  # guarantee re-lock
  else
    echo "WARNING: rootfs-rw failed; sudo installs may fail on read-only dirs."
  fi
}

rootfs_relock() {
  [ -n "$ROOTFS_WE_UNLOCKED" ] || return 0
  command -v rootfs-ro >/dev/null 2>&1 || return 0
  log "Re-locking rootfs (rootfs-ro)"
  sudo rootfs-ro || echo "WARNING: rootfs-ro failed; rootfs left writable."
  ROOTFS_WE_UNLOCKED=""
  trap - EXIT INT TERM
}

ensure_brew() {
  for p in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
    [ -x "$p" ] && eval "$("$p" shellenv)" && return 0
  done
  log "Installing Homebrew"
  # NOTE: On Linux, Homebrew's first-time install needs sudo to create
  # /home/linuxbrew. If you have no root at all, pre-install brew to a path you
  # own and re-run. (See https://docs.brew.sh/Installation for a no-sudo path.)
  NONINTERACTIVE=1 /bin/bash -c \
    "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  for p in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
    [ -x "$p" ] && eval "$("$p" shellenv)" && return 0
  done
}

# System packages (Linux, apt) — only when we have root. On macOS the C
# toolchain comes from Xcode CLT; everything else comes from brew.
install_system_packages() {
  if [ "$OS" = "Darwin" ]; then
    xcode-select -p >/dev/null 2>&1 || xcode-select --install || true
    return 0
  fi
  if ! have_sudo; then
    log "No sudo (or NO_SUDO set): skipping apt packages."
    echo "  Make sure a C compiler + headers exist for treesitter, e.g.:"
    echo "    sudo apt-get install build-essential"
    echo "  Otherwise brew's gcc is used, which still needs system libc headers."
    return 0
  fi
  local distro perf_pkg
  distro="$(grep '^ID=' /etc/os-release | cut -d= -f2 | tr -d '"')"
  if [ "$distro" = "ubuntu" ]; then perf_pkg="linux-tools-common"; else perf_pkg="linux-perf"; fi

  # build-essential provides the C compiler + libc headers treesitter needs.
  local want missing=""
  for want in \
    build-essential \
    "$perf_pkg" \
    apt-transport-https ca-certificates \
    git git-lfs \
    htop \
    python3-pip python3-venv pipx \
    jq curl \
    default-jre \
    xclip \
    lshw net-tools psmisc; do
    # Keep only packages that are not already installed.
    dpkg -s "$want" >/dev/null 2>&1 || missing="$missing $want"
  done

  if [ -z "$missing" ]; then
    log "All apt packages already installed; skipping (no rootfs unlock needed)."
    return 0
  fi

  log "Installing missing apt packages:$missing"
  rootfs_ensure_rw                 # unlock only now that we know we must write
  sudo apt-get update
  # shellcheck disable=SC2086  # intentional word-splitting of the package list
  sudo apt-get install -y $missing
}

# Everything else via brew (no root needed once brew exists).
install_brew_packages() {
  log "Installing Homebrew packages"
  brew update
  # Core CLI + editor + shell niceties, all user-local via brew.
  brew install \
    neovim \
    tmux \
    zsh \
    zsh-autosuggestions \
    zsh-syntax-highlighting \
    fnm \
    ripgrep fd jq git-lfs httpie fzf kubernetes-cli
  if [ -z "$SKIP_DEVTOOLS" ]; then
    brew install awscli deno opentofu graphviz
  fi
}

# linuxdev extras need root (docker/microk8s touch system services).
install_role_extras() {
  [ "$OS" != "Linux" ] && return 0
  [ "$ROLE" = "linuxdev" ] || return 0
  [ -n "$SKIP_DEVTOOLS" ] && return 0
  if ! have_sudo; then
    log "linuxdev role requested but no sudo: skipping docker/microk8s."
    return 0
  fi

  # Decide what actually needs installing (both sub-scripts are idempotent, but
  # we check here too so we only unlock the rootfs when there is real work).
  local sdir="$HOME/.local/share/chezmoi/scripts"
  local need_docker="" need_microk8s=""
  [ -x "$sdir/install_docker.sh" ]   && ! docker version        >/dev/null 2>&1 && need_docker=1
  [ -x "$sdir/install_microk8s.sh" ] && [ -z "$(snap microk8s --version 2>/dev/null)" ] && need_microk8s=1

  if [ -z "$need_docker" ] && [ -z "$need_microk8s" ]; then
    log "docker + microk8s already present; skipping (no rootfs unlock needed)."
    return 0
  fi

  log "linuxdev role: installing docker + microk8s"
  rootfs_ensure_rw                 # unlock only now that we know we must write
  [ -n "$need_microk8s" ] && "$sdir/install_microk8s.sh" || true
  [ -n "$need_docker" ]   && "$sdir/install_docker.sh" || true
}

# Tailscale (mesh VPN), all machines. CLI and daemon ship as one package.
#   Linux : scripts/install_tailscale.sh runs the official installer (apt repo
#           + tailscaled systemd service); needs root and touches the rootfs,
#           so we unlock lazily — only when tailscale is actually missing.
#   macOS : brew cask.
# Idempotent: skips entirely if the tailscale binary already exists (and then
# a read-only rootfs is never unlocked).
install_tailscale() {
  if command -v tailscale >/dev/null 2>&1; then
    log "tailscale already installed ($(tailscale version 2>/dev/null | head -1)); skipping."
    return 0
  fi

  if [ "$OS" = "Darwin" ]; then
    log "Installing tailscale (brew cask)"
    brew install --cask tailscale
    return 0
  fi

  if ! have_sudo; then
    log "No sudo (or NO_SUDO set): skipping tailscale."
    echo "  Install later with: scripts/install_tailscale.sh"
    return 0
  fi
  log "Installing tailscale (systemd service)"
  rootfs_ensure_rw                 # unlock only now that we know we must write
  local sdir="$HOME/.local/share/chezmoi/scripts"
  [ -x "$sdir/install_tailscale.sh" ] && "$sdir/install_tailscale.sh" || true
}

# brew installs to its own prefix and needs no root / no rootfs unlock.
# System/apt steps unlock the rootfs lazily (only when they have something to
# install); the EXIT trap set by rootfs_ensure_rw re-locks afterwards.
install_system_packages
install_role_extras
install_tailscale

ensure_brew
install_brew_packages

log "Package installation complete."
