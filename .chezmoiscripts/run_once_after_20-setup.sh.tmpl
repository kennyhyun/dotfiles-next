#!/usr/bin/env bash
# Post-apply setup: Node (fnm), tmux plugin manager, SSH keys, git identity,
# and Neovim plugin sync. Runs once (re-runs if contents change).

set -euo pipefail

log() { printf '\n\033[1;34m==> %s\033[0m\n' "$*"; }

# ---- Homebrew into PATH for this script ----
for p in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
  [ -x "$p" ] && eval "$("$p" shellenv)" && break
done

# ---- Node via fnm (Fast Node Manager; replaces nvm) ----
# fnm is installed by the package script (brew). Everything lives under the
# user's home — no root required.
if command -v fnm >/dev/null 2>&1; then
  eval "$(fnm env --shell bash)"
  if ! fnm list 2>/dev/null | grep -qiE 'lts|v[0-9]'; then
    log "Installing Node LTS via fnm"
    fnm install --lts
    fnm default "$(fnm list 2>/dev/null | grep -oE 'v[0-9]+\.[0-9]+\.[0-9]+' | tail -1)" 2>/dev/null || true
  fi
  if command -v npm >/dev/null 2>&1; then
    npm i -g yarn prettier >/dev/null 2>&1 || true
  fi
else
  echo "fnm not found; skipping Node install. Install fnm then run: fnm install --lts"
fi

# ---- tmux plugin manager (tpm) ----
if [ ! -d "$HOME/.tmux/plugins/tpm" ]; then
  log "Installing tmux plugin manager (tpm)"
  mkdir -p "$HOME/.tmux/plugins"
  git clone --depth 1 https://github.com/tmux-plugins/tpm "$HOME/.tmux/plugins/tpm"
fi

# ---- SSH keys (ed25519; security upgrade from legacy RSA-2048) ----
mkdir -p "$HOME/.ssh" && chmod 700 "$HOME/.ssh"
if [ ! -f "$HOME/.ssh/id_ed25519" ]; then
  log "Generating ed25519 SSH key"
  ssh-keygen -t ed25519 -a 100 -f "$HOME/.ssh/id_ed25519" -q -N "" -C "$USER@$(hostname)"
fi
# Separate bastion key (legacy copied id_rsa; we generate a distinct key so
# the two identities are not shared).
if [ ! -f "$HOME/.ssh/id_ed25519_bastion" ]; then
  log "Generating separate ed25519 bastion key"
  ssh-keygen -t ed25519 -a 100 -f "$HOME/.ssh/id_ed25519_bastion" -q -N "" -C "$USER-bastion@$(hostname)"
fi

# ---- git identity ----
# ---- Machine-specific config files (NOT managed by chezmoi) ----
# Ensure they exist so the managed ~/.zshrc source and ~/.gitconfig include
# never error. Host-specific settings live here and survive re-apply.
[ -f "$HOME/.zshrc.local" ] || touch "$HOME/.zshrc.local"
[ -f "$HOME/.gitconfig.local" ] || touch "$HOME/.gitconfig.local"

# ---- git identity (written to ~/.gitconfig.local, kept out of the repo) ----
set +e
name="$(git config user.name)"
email="$(git config user.email)"
set -e
git config --global core.excludesfile "$HOME/.gitignore_global" || true
if [ -t 1 ]; then
  [ -z "$name" ] && name="$USER"
  printf 'git user.name [%s]: ' "$name"; read -r in_name; [ -n "$in_name" ] && name="$in_name"
  printf 'git user.email [%s]: ' "$email"; read -r in_email; [ -n "$in_email" ] && email="$in_email"
  git config --file "$HOME/.gitconfig.local" user.name "$name"
  [ -n "$email" ] && git config --file "$HOME/.gitconfig.local" user.email "$email"
else
  if [ -z "$name" ] || [ -z "$email" ]; then
    echo "Set your git identity in ~/.gitconfig.local:"
    echo "  git config --file ~/.gitconfig.local user.name  <Name>"
    echo "  git config --file ~/.gitconfig.local user.email <Email>"
  fi
fi

# ---- Neovim: install/sync plugins headlessly ----
if command -v nvim >/dev/null 2>&1; then
  log "Syncing Neovim plugins (lazy)"
  nvim --headless "+Lazy! sync" +qa 2>/dev/null || true
  nvim --headless "+TSUpdateSync" +qa 2>/dev/null || true
fi

# ---- default shell ----
# chsh edits /etc/passwd and needs root. Skip gracefully without sudo so this
# works on machines where you only have your home directory.
zsh_path="$(command -v zsh || true)"
if [ -n "$zsh_path" ] && [ "${SHELL:-}" != "$zsh_path" ]; then
  if [ -z "${NO_SUDO:-}" ] && command -v sudo >/dev/null 2>&1 && sudo -n true 2>/dev/null; then
    log "Setting default shell to zsh"
    sudo chsh -s "$zsh_path" "$USER" 2>/dev/null || \
      echo "Could not change shell automatically; run: chsh -s $zsh_path"
  else
    echo "Skipping default-shell change (no sudo). To use zsh without chsh, add"
    echo "to ~/.bashrc:  [ -z \"\$ZSH_VERSION\" ] && exec $zsh_path -l"
  fi
fi

log "Setup complete. Public keys to register with GitHub/GitLab:"
echo "----- id_ed25519.pub -----"; cat "$HOME/.ssh/id_ed25519.pub"
echo "Please log out and back in to pick up the new shell/env."
