#!/usr/bin/env bash
# Post-apply setup: Node (fnm), tmux plugin manager, SSH keys, git identity,
# and Neovim plugin sync. Runs once (re-runs if contents change).

set -euo pipefail

log() { printf '\n\033[1;34m==> %s\033[0m\n' "$*"; }

# Role awareness (mirrors the package script). SKIP_DEVTOOLS (set by PRODUCTION
# or the lite role) means no developer tooling — including Node, which we treat
# as dev tooling. LITE additionally runs Neovim plugin-free.
ROLE="${DOTFILES_ROLE:-base}"
LITE=""
[ "$ROLE" = "lite" ] && LITE=1
SKIP_DEVTOOLS=""
{ [ -n "${PRODUCTION:-}" ] || [ -n "$LITE" ]; } && SKIP_DEVTOOLS=1

# ---- Homebrew into PATH for this script ----
for p in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
  [ -x "$p" ] && eval "$("$p" shellenv)" && break
done

# ---- Node via fnm (Fast Node Manager; replaces nvm) ----
# fnm is installed by the package script (brew) only when dev tooling is
# enabled. Node is dev tooling, so PRODUCTION / lite skip it entirely.
if [ -n "$SKIP_DEVTOOLS" ]; then
  log "Dev tooling disabled (PRODUCTION/lite): skipping Node toolchain."
elif command -v fnm >/dev/null 2>&1; then
  eval "$(fnm env --shell bash)"
  if ! fnm list 2>/dev/null | grep -qiE 'lts|v[0-9]'; then
    log "Installing Node LTS via fnm"
    fnm install --lts
    fnm default "$(fnm list 2>/dev/null | grep -oE 'v[0-9]+\.[0-9]+\.[0-9]+' | tail -1)" 2>/dev/null || true
  fi
  if command -v npm >/dev/null 2>&1; then
    npm i -g yarn prettier >/dev/null 2>&1 || true
  fi
else
  echo "fnm not found; skipping Node install. Install fnm then run: fnm install --lts"
fi

# ---- tmux plugin manager (tpm) ----
if [ ! -d "$HOME/.tmux/plugins/tpm" ]; then
  log "Installing tmux plugin manager (tpm)"
  mkdir -p "$HOME/.tmux/plugins"
  git clone --depth 1 https://github.com/tmux-plugins/tpm "$HOME/.tmux/plugins/tpm"
fi

# ---- SSH keys (ed25519; security upgrade from legacy RSA-2048) ----
mkdir -p "$HOME/.ssh" && chmod 700 "$HOME/.ssh"
if [ ! -f "$HOME/.ssh/id_ed25519" ]; then
  log "Generating ed25519 SSH key"
  ssh-keygen -t ed25519 -a 100 -f "$HOME/.ssh/id_ed25519" -q -N "" -C "$USER@$(hostname)"
fi
# Separate bastion key (legacy copied id_rsa; we generate a distinct key so
# the two identities are not shared).
if [ ! -f "$HOME/.ssh/id_ed25519_bastion" ]; then
  log "Generating separate ed25519 bastion key"
  ssh-keygen -t ed25519 -a 100 -f "$HOME/.ssh/id_ed25519_bastion" -q -N "" -C "$USER-bastion@$(hostname)"
fi

# ---- git identity ----
# ---- ~/.zshrc: user-owned, sources the shared chezmoi config on its FIRST line ----
# chezmoi does NOT manage ~/.zshrc (see .chezmoiignore). Instead we make sure it
# exists and that its first line pulls in ~/.config/zsh/chezmoi.zsh. Everything
# below that line is yours — ~/.zshrc now plays the role the old ~/.zshrc.local
# used to. Idempotent: the source line is inserted only if not already present.
ZSHRC="$HOME/.zshrc"
SOURCE_LINE='[ -r ~/.config/zsh/chezmoi.zsh ] && source ~/.config/zsh/chezmoi.zsh'
MARKER='chezmoi.zsh'                       # substring that identifies the line

[ -f "$ZSHRC" ] || { touch "$ZSHRC"; log "Created empty ~/.zshrc"; }

if ! grep -qF "$MARKER" "$ZSHRC" 2>/dev/null; then
  log "Linking ~/.zshrc -> shared config (prepending source line)"
  # Prepend the source line as the very first line, keeping existing content.
  tmp="$(mktemp)"
  {
    printf '%s\n' "# Source shared chezmoi zsh config (managed). Keep this first."
    printf '%s\n' "$SOURCE_LINE"
    printf '\n'
    cat "$ZSHRC"
  } > "$tmp"
  mv "$tmp" "$ZSHRC"
fi

# ---- Optional prompt module (user-togglable) ----
# Add a source line for the managed prompt (~/.config/zsh/chezmoi.zsh.prompt).
# It is appended ONCE, and only if no reference to it exists yet — INCLUDING a
# commented-out one. So if you disable the prompt on a machine by deleting or
# commenting the line, setup will NOT re-add it. Grep is comment-agnostic (it
# matches the path substring whether the line is active or commented).
PROMPT_LINE='[ -r ~/.config/zsh/chezmoi.zsh.prompt ] && source ~/.config/zsh/chezmoi.zsh.prompt'
PROMPT_MARKER='chezmoi.zsh.prompt'         # distinct from the base marker above

if ! grep -qF "$PROMPT_MARKER" "$ZSHRC" 2>/dev/null; then
  log "Adding optional prompt source line to ~/.zshrc (comment it out to disable)"
  {
    printf '\n%s\n' "# Optional managed prompt. Comment out or delete this line to disable it"
    printf '%s\n' "# on this machine; it will NOT be re-added once removed/commented."
    printf '%s\n' "$PROMPT_LINE"
  } >> "$ZSHRC"
fi

# ---- git identity: ~/.gitconfig.local (still kept out of the repo) ----
[ -f "$HOME/.gitconfig.local" ] || touch "$HOME/.gitconfig.local"

# ---- git identity (written to ~/.gitconfig.local, kept out of the repo) ----
set +e
name="$(git config user.name)"
email="$(git config user.email)"
set -e
git config --global core.excludesfile "$HOME/.gitignore_global" || true
if [ -t 1 ]; then
  [ -z "$name" ] && name="$USER"
  printf 'git user.name [%s]: ' "$name"; read -r in_name; [ -n "$in_name" ] && name="$in_name"
  printf 'git user.email [%s]: ' "$email"; read -r in_email; [ -n "$in_email" ] && email="$in_email"
  git config --file "$HOME/.gitconfig.local" user.name "$name"
  [ -n "$email" ] && git config --file "$HOME/.gitconfig.local" user.email "$email"
else
  if [ -z "$name" ] || [ -z "$email" ]; then
    echo "Set your git identity in ~/.gitconfig.local:"
    echo "  git config --file ~/.gitconfig.local user.name  <Name>"
    echo "  git config --file ~/.gitconfig.local user.email <Email>"
  fi
fi

# ---- Neovim: install/sync plugins headlessly ----
# On the lite role Neovim is plugin-free (init.lua returns early), so there is
# nothing to sync — skip to avoid cloning lazy.nvim / compiling treesitter.
if [ -n "$LITE" ]; then
  log "lite role: Neovim is plugin-free; skipping plugin sync."
elif command -v nvim >/dev/null 2>&1; then
  log "Syncing Neovim plugins (lazy)"
  nvim --headless "+Lazy! sync" +qa 2>/dev/null || true
  nvim --headless "+TSUpdateSync" +qa 2>/dev/null || true
fi

# ---- default shell ----
# chsh edits /etc/passwd (and zsh must be listed in /etc/shells), both of which
# live on the (possibly read-only) rootfs. Skip gracefully without sudo.
zsh_path="$(command -v zsh || true)"
if [ -n "$zsh_path" ] && [ "${SHELL:-}" != "$zsh_path" ]; then
  if [ -z "${NO_SUDO:-}" ] && command -v sudo >/dev/null 2>&1 && sudo -n true 2>/dev/null; then
    # Unlock read-only rootfs if the linuxdev helpers are present and needed.
    relock=""
    if command -v rootfs-rw >/dev/null 2>&1 && ! sudo test -w /etc 2>/dev/null; then
      log "Read-only rootfs: unlocking for chsh"
      sudo rootfs-rw && relock=1
      [ -n "$relock" ] && trap 'sudo rootfs-ro || true' EXIT INT TERM
    fi
    log "Setting default shell to zsh"
    # Ensure the shell is registered in /etc/shells, then switch.
    grep -qxF "$zsh_path" /etc/shells 2>/dev/null || echo "$zsh_path" | sudo tee -a /etc/shells >/dev/null
    sudo chsh -s "$zsh_path" "$USER" 2>/dev/null || \
      echo "Could not change shell automatically; run: chsh -s $zsh_path"
    if [ -n "$relock" ]; then
      log "Re-locking rootfs"
      sudo rootfs-ro || echo "WARNING: rootfs-ro failed; rootfs left writable."
      trap - EXIT INT TERM
    fi
  else
    echo "Skipping default-shell change (no sudo). To use zsh without chsh, add"
    echo "to ~/.bashrc:  [ -z \"\$ZSH_VERSION\" ] && exec $zsh_path -l"
  fi
fi

log "Setup complete. Public keys to register with GitHub/GitLab:"
echo "----- id_ed25519.pub -----"; cat "$HOME/.ssh/id_ed25519.pub"
echo "Please log out and back in to pick up the new shell/env."
